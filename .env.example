# Copy to .env. Never commit .env or real credentials.
# Default Compose binding is localhost:8080 only.
APP_ENV=development
APP_ACCESS_TOKEN=
DATABASE_URL=sqlite:////data/copilot.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Basic OpenAlex and Crossref require no paid credentials.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
# Optional enrichment. Unpaywall needs your contact email.
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=

# none | openai | ollama. No model is required for search or source extracts.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# For public backend hosting: APP_ENV=production, a strong unique
# APP_ACCESS_TOKEN, HTTPS reverse proxy and explicit CORS origins.
# Add https://airspiritfox.github.io to CORS_ORIGINS for the Pages client.
# Generate a token locally with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the complete /data volume, including its encryption key, in backups.
# Optional production database example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/copilot
